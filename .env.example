# Kick channel to monitor. Do NOT include https://kick.com/
KICK_CHANNEL_SLUG=your_channel_slug

# Optional but recommended: create a Kick Developer App.
# App Access Tokens can read public channel/livestream data.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Performance / runtime
KICK_API_POLL_SECONDS=15
KICK_METADATA_POLL_SECONDS=30
KICK_RECONNECT_DELAY_SECONDS=5
KICK_OFFLINE_GRACE_SECONDS=90
DB_BATCH_SIZE=250
DB_BATCH_WAIT_MS=250
MAX_JSONL_MB=200
RAW_JSON_IN_DB=0
PRINT_CHAT=0
LOG_OFFSTREAM_CHAT=0

# Pusher public app key. Change only if Kick rotates it.
KICK_PUSHER_KEY=32cbd69e4b950bf97679
KICK_PUSHER_REGION=us2

# Dashboard scalability / protection
LIVE_CACHE_TTL=30
HISTORICAL_CACHE_TTL=600
STREAMS_CACHE_TTL=30
CACHE_MAX_ENTRIES=32
MAX_WS_CLIENTS=10000
BROADCAST_FLUSH_MS=200
MAX_BROADCAST_QUEUE=5000
# Set to 1 only when the app is behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=0
